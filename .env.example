# ==============================================================================
# Variables de Entorno para Conexión a Databricks y Pipelines
# Copia este archivo a .env y completa tus credenciales locales:
# cp .env.example .env
# ==============================================================================

# Conexión Databricks Community / Workspace
DATABRICKS_HOST=https://community.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/protocolv1/o/0/xxxx-xxxxxx-xxxxxxxx
DATABRICKS_TOKEN=dapi_tu_token_personal_aqui

# Catálogo (opcional, en Community Edition se usa hive_metastore)
DATABRICKS_CATALOG=hive_metastore

# Ambiente de ejecución para ingesta DBFS (dev | qas | prd)
ENV=dev
